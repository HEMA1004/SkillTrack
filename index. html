<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkillTrack | Student Dashboard</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f7ff;
    color: #1f2937;
}

header {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    color: white;
    padding: 35px 8%;
}

header h1 {
    font-size: 34px;
    margin-bottom: 8px;
}

header p {
    font-size: 16px;
    opacity: 0.9;
}

.container {
    width: 85%;
    max-width: 1100px;
    margin: 30px auto;
}

.welcome {
    background: white;
    padding: 25px;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.07);
    margin-bottom: 25px;
}

.welcome h2 {
    margin-bottom: 8px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.07);
}

.card h3 {
    margin-bottom: 12px;
}

.number {
    font-size: 32px;
    font-weight: bold;
    color: #4f46e5;
}

.section {
    background: white;
    padding: 25px;
    border-radius: 18px;
    margin-bottom: 25px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.07);
}

.section h2 {
    margin-bottom: 20px;
}

.skill {
    margin-bottom: 20px;
}

.skill-title {
    display: flex;
    justify-content: space-between;
    margin-bottom: 7px;
}

.progress {
    height: 11px;
    background: #e5e7eb;
    border-radius: 20px;
    overflow: hidden;
}

.bar {
    height: 100%;
    background: linear-gradient(90deg, #4f46e5, #7c3aed);
    border-radius: 20px;
}

.internship {
    border: 1px solid #e5e7eb;
    padding: 18px;
    border-radius: 14px;
    margin-bottom: 15px;
}

.internship h3 {
    margin-bottom: 8px;
}

.status {
    display: inline-block;
    margin-top: 10px;
    padding: 6px 14px;
    border-radius: 20px;
    background: #dcfce7;
    color: #166534;
    font-size: 13px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #6b7280;
}

@media (max-width: 700px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .container {
        width: 90%;
    }

    header h1 {
        font-size: 28px;
    }
}
</style>
</head>

<body>

<header>
    <h1>SkillTrack 🚀</h1>
    <p>Student Skill & Internship Tracker</p>
</header>

<div class="container">

    <div class="welcome">
        <h2>Welcome, Hema 👋</h2>
        <p>
            Track your skills, learning progress and internship journey
            in one simple dashboard.
        </p>
    </div>

    <div class="cards">

        <div class="card">
            <h3>📚 Skills</h3>
            <div class="number">3</div>
            <p>Skills Learning</p>
        </div>

        <div class="card">
            <h3>💼 Internships</h3>
            <div class="number">2</div>
            <p>Applications</p>
        </div>

        <div class="card">
            <h3>📈 Progress</h3>
            <div class="number">65%</div>
            <p>Overall Learning</p>
        </div>

    </div>

    <div class="section">
        <h2>My Skills 📚</h2>

        <div class="skill">
            <div class="skill-title">
                <span>HTML</span>
                <span>80%</span>
            </div>

            <div class="progress">
                <div class="bar" style="width:80%"></div>
            </div>
        </div>

        <div class="skill">
            <div class="skill-title">
                <span>CSS</span>
                <span>70%</span>
            </div>

            <div class="progress">
                <div class="bar" style="width:70%"></div>
            </div>
        </div>

        <div class="skill">
            <div class="skill-title">
                <span>Python</span>
                <span>50%</span>
            </div>

            <div class="progress">
                <div class="bar" style="width:50%"></div>
            </div>
        </div>

    </div>

    <div class="section">
        <h2>Internship Tracker 💼</h2>

        <div class="internship">
            <h3>Web Development Intern</h3>
            <p>Company: Example Company</p>
            <p>Application Status:</p>
            <span class="status">Applied</span>
        </div>

        <div class="internship">
            <h3>Python Developer Intern</h3>
            <p>Company: Example Company</p>
            <p>Application Status:</p>
            <span class="status">Applied</span>
        </div>

    </div>

</div>

<footer>
    <p>© 2026 SkillTrack | Built by Hema</p>
</footer>

</body>
</html>
           
